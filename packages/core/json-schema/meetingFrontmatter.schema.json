{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hecate:meetingFrontmatter:v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/Ulid"
    },
    "date": {
      "$ref": "#/$defs/IsoDate"
    },
    "title": {
      "$ref": "#/$defs/Line"
    },
    "input": {
      "type": "string",
      "enum": [
        "transcript",
        "notes",
        "multi-source"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Line"
      }
    },
    "conflicts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "projectIds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Ulid"
      }
    },
    "personIds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Ulid"
      }
    },
    "keys": {
      "$ref": "#/$defs/Keys"
    },
    "processedAt": {
      "$ref": "#/$defs/Instant"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "date",
    "title",
    "input",
    "sources",
    "conflicts",
    "projectIds",
    "personIds",
    "keys",
    "processedAt"
  ],
  "additionalProperties": false,
  "$defs": {
    "Ulid": {
      "type": "string",
      "format": "ulid",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{25}$"
    },
    "IsoDate": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "Line": {
      "type": "string",
      "maxLength": 500,
      "pattern": "^\\S(?:[^\\r\\n]*\\S)?$"
    },
    "Keys": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TaskKey"
      }
    },
    "TaskKey": {
      "type": "string",
      "pattern": "^[AB][1-9]\\d*$"
    },
    "Instant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  }
}
