{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hecate:activityEntry:v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/Ulid"
    },
    "at": {
      "$ref": "#/$defs/Instant"
    },
    "date": {
      "$ref": "#/$defs/IsoDate"
    },
    "actor": {
      "type": "string",
      "enum": [
        "app",
        "claude",
        "bot",
        "import"
      ]
    },
    "type": {
      "type": "string",
      "enum": [
        "flag",
        "session",
        "event"
      ]
    },
    "area": {
      "anyOf": [
        {
          "$ref": "#/$defs/Slug"
        },
        {
          "type": "null"
        }
      ]
    },
    "delta": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^\\S(?:[^\\r\\n]*\\S)?$"
    },
    "pointers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Line"
      }
    },
    "keys": {
      "$ref": "#/$defs/Keys"
    },
    "opId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "at",
    "date",
    "actor",
    "type",
    "area",
    "delta",
    "pointers",
    "keys",
    "opId"
  ],
  "additionalProperties": false,
  "$defs": {
    "Ulid": {
      "type": "string",
      "format": "ulid",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{25}$"
    },
    "Instant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "IsoDate": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "Slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "Line": {
      "type": "string",
      "maxLength": 500,
      "pattern": "^\\S(?:[^\\r\\n]*\\S)?$"
    },
    "Keys": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TaskKey"
      }
    },
    "TaskKey": {
      "type": "string",
      "pattern": "^[AB][1-9]\\d*$"
    }
  }
}
