{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hecate:keepInMind:v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "updatedAt": {
      "$ref": "#/$defs/Instant"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/Ulid"
          },
          "lead": {
            "anyOf": [
              {
                "$ref": "#/$defs/Line"
              },
              {
                "type": "null"
              }
            ]
          },
          "text": {
            "$ref": "#/$defs/Markdown"
          },
          "keys": {
            "$ref": "#/$defs/Keys"
          },
          "projectId": {
            "anyOf": [
              {
                "$ref": "#/$defs/Ulid"
              },
              {
                "type": "null"
              }
            ]
          },
          "createdAt": {
            "$ref": "#/$defs/Instant"
          }
        },
        "required": [
          "id",
          "lead",
          "text",
          "keys",
          "projectId",
          "createdAt"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "updatedAt",
    "items"
  ],
  "additionalProperties": false,
  "$defs": {
    "Instant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "Ulid": {
      "type": "string",
      "format": "ulid",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{25}$"
    },
    "Line": {
      "type": "string",
      "maxLength": 500,
      "pattern": "^\\S(?:[^\\r\\n]*\\S)?$"
    },
    "Markdown": {
      "type": "string",
      "contentMediaType": "text/markdown"
    },
    "Keys": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TaskKey"
      }
    },
    "TaskKey": {
      "type": "string",
      "pattern": "^[AB][1-9]\\d*$"
    }
  }
}
