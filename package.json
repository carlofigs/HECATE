{
  "name": "hecate",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter web-v1 dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "knip": "knip",
    "mcp": "pnpm --filter @hecate/mcp-v1 start",
    "migrate-v1": "pnpm --filter @hecate/migrate-v1 migrate",
    "package-skills": "pnpm --filter @hecate/plugin package",
    "export-schema": "pnpm --filter @hecate/core export-schema"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "knip": "^6.44.1",
    "typescript": "catalog:",
    "typescript-eslint": "^8.72.1"
  }
}
