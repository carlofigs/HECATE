# Review artefacts — prompts and reports from development review cycles
.review/

# Dependencies
node_modules/

# Local data — never commit; sensitive work data lives in the configured private GitHub repo
data/

# Private working docs — reference private workspace/client names; kept local-only
# since this repo is public. The canonical copies live on the maintainer's machine.
HECATE_CONTEXT.md
HECATE_COWORK_SETUP.md
HECATE_PROJECT_INSTRUCTIONS.md

# Build output
dist/

# Environment
.env
.env.local
.env.*.local

# Editor
.vscode/
.idea/
*.swp
*.swo

# Claude Code — machine-local permission grants (contains absolute local paths).
# Shared .claude config (commands, agents) is NOT ignored and can be committed.
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db

# TypeScript
*.tsbuildinfo

# Vite
.vite/

# Tool scratch state — link/credential files that CLIs drop in the working
# directory. A CLI run from the wrong cwd lands these in the repo root, where
# `git add -A` would publish them; this repo is public, so that is a real leak
# rather than just noise. (Already happened once: a stray Supabase link file for
# an unrelated project, Sep 2026.)
#
# Deliberately narrow. `supabase/.temp/` is scratch, but `supabase/migrations/`
# and `supabase/config.toml` are project files that MUST be committed — so do
# not widen this to `supabase/`. The storage substrate is still an open question
# and Supabase is a live candidate; ignoring the whole directory would silently
# drop real migrations the day that decision lands.
supabase/.temp/
supabase/.branches/
supabase/.env
.wrangler/
.vercel/
.netlify/
